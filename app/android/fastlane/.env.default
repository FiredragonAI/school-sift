# fastlane 自动读取的公开配置(不放密钥)。密钥:签名在 app/android/key.properties,Play 在 ~/.secrets/school-sift/。
# 「用英文回复」反馈卡的表单地址,和网页版仓库变量 FEEDBACK_FORM_URL 保持一致
FEEDBACK_FORM_URL="https://docs.google.com/forms/d/e/1FAIpQLSc6BK0tbQsFJWarbE85AwvxwTULahXb93AQCKPlEQZY2XbUhg/viewform?usp=pp_url&entry.2112494063={rating}&entry.899003351={count}&entry.1036386670={keyboard}&entry.556464604={lang}"
# 关掉 fastlane 的匿名使用统计
FASTLANE_OPT_OUT_USAGE="YES"
FASTLANE_SKIP_UPDATE_CHECK="YES"
